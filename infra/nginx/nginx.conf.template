# Reverse proxy: /v1 -> api, /admin/ -> admin, /media -> uploaded photos.
# Rendered at container start by render.sh (envsubst): the ADMIN_ALLOW_RULES placeholder comes from
# ADMIN_ALLOW_CIDR (comma-separated CIDRs; empty = /admin reachable from anywhere, protected
# by staff login + TOTP only). TLS: terminate at a load balancer (X-Forwarded-Proto is passed
# through) or add the 443 server from tls.conf.example.
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;
    server_tokens off;
    client_max_body_size 10m;

    gzip on;
    gzip_types application/json text/css application/javascript text/plain;
    gzip_min_length 1024;

    # $uri, never $request_uri: query strings may carry secrets and personal data.
    log_format json escape=json '{"time":"$time_iso8601","request_id":"$req_id",'
        '"remote":"$remote_addr","method":"$request_method","uri":"$uri",'
        '"status":$status,"bytes":$body_bytes_sent,"duration":$request_time,'
        '"upstream":"$upstream_addr"}';
    access_log /dev/stdout json;
    error_log /dev/stderr warn;

    # Rate limits per client address (behind a load balancer, configure set_real_ip_from).
    limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=admin_login:10m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=admin:10m rate=20r/s;
    limit_req_status 429;

    upstream api {
        server api:8000;
        keepalive 32;
    }

    upstream admin {
        server admin:8001;
    }

    # Keep the client's X-Request-ID if it sent one, else use nginx's own.
    map $http_x_request_id $req_id {
        default $http_x_request_id;
        ""      $request_id;
    }

    # A load balancer in front terminates TLS and says so: pass it through (else our scheme).
    map $http_x_forwarded_proto $fwd_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }

    # HSTS only when the client connection is HTTPS (here or at the load balancer).
    map $fwd_proto $hsts {
        https   "max-age=31536000; includeSubDomains";
        default "";
    }

    server {
        listen 80;
        server_name _;

        include /etc/nginx/snippets/security-headers.conf;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_set_header X-Request-ID $req_id;
        proxy_read_timeout 60s;

        location = /healthz {
            access_log off;
            default_type application/json;
            return 200 '{"status":"ok"}';
        }

        # OTP send / verify / refresh: SMS pumping and brute-force guard (the API adds
        # per-number, per-device, per-IP and global limits on top).
        location /v1/auth/ {
            limit_req zone=auth burst=10 nodelay;
            proxy_pass http://api;
        }

        location /v1/ {
            proxy_pass http://api;
        }

        location = /admin {
            return 301 /admin/;
        }

        location = /admin/login {
            ${ADMIN_ALLOW_RULES}
            limit_req zone=admin_login burst=5 nodelay;
            include /etc/nginx/snippets/admin-headers.conf;
            proxy_pass http://admin;
        }

        location /admin/ {
            ${ADMIN_ALLOW_RULES}
            limit_req zone=admin burst=60 nodelay;
            include /etc/nginx/snippets/admin-headers.conf;
            proxy_pass http://admin;
        }

        # Data exports are personal data: only the API serves them (authenticated download).
        location /media/exports/ {
            return 404;
        }

        # Recipe photos uploaded through the admin (shared media_data volume, read-only here).
        location /media/ {
            alias /srv/media/;
            access_log off;
            expires 30d;
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "public" always;
            autoindex off;
        }

        location / {
            return 404;
        }
    }

    # TLS at nginx: see tls.conf.example, then uncomment.
    # include /etc/nginx/tls.conf;
}

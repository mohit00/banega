# Dev: copy to infra/.env. Production uses infra/.env.prod.example (infra/deploy/README.md).
# Outside ENV=dev/test the API refuses to boot with dev values (see backend/README.md,
# "Hardening"): the prod compose override requires every secret below.
ENV=dev

POSTGRES_USER=banega
POSTGRES_PASSWORD=banega-dev-password
POSTGRES_DB=banega
# Used by api, worker, migrate and admin (host "db" is the compose service). The prod
# override builds it from POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://banega:banega-dev-password@db:5432/banega
REDIS_URL=redis://redis:6379/0
# Prod only (redis requirepass; REDIS_URL is built from it).
REDIS_PASSWORD=

# At least 32 random bytes in prod: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-jwt-secret-change-me-please-0123456789
# Optional separate keys for OTP-code and invite-token hashes (empty = derived from JWT_SECRET).
OTP_HMAC_KEY=
INVITE_HMAC_KEY=
# dev | msg91 (backend/README.md "MSG91 OTP": DLT template, auth key)
OTP_PROVIDER=dev
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
# 1 = channel=voice requests use MSG91's voice retry
OTP_VOICE_FALLBACK=0
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=

# Maharaj chat (Phase 4). Empty key = rule parser + template replies only (no LLM calls).
ANTHROPIC_API_KEY=
MAHARAJ_PARSE_MODEL=claude-sonnet-5
MAHARAJ_WRITE_MODEL=claude-sonnet-5
# LLM calls (parse + write) per household per day; beyond it, rules + templates.
MAHARAJ_DAILY_BUDGET=200

# ---- Phase 5: notifications ----
# noop = log only (dev); fcm = FCM HTTP v1 with a Firebase service account (file path or
# inline JSON; FCM_PROJECT_ID defaults to the account's project_id).
# Outside dev/test noop refuses to boot unless ALLOW_NOOP_PUSH=1 (staging).
PUSH_PROVIDER=noop
FCM_PROJECT_ID=banega-fb1ed
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
ALLOW_NOOP_PUSH=0

# ---- Phase 7: billing ----
# auto = fakes in dev/test, real verification elsewhere (fake is refused outside dev/test).
STORE_VERIFIER=auto
# Play RTDN: X-Webhook-Secret header (never ?token=) and/or the Pub/Sub push OIDC token.
PLAY_WEBHOOK_SECRET=
PLAY_PUBSUB_AUDIENCE=
PLAY_PUBSUB_SERVICE_ACCOUNT=
# Play Developer API (subscription state + acknowledge) via a service account.
PLAY_PACKAGE_NAME=in.kornea.banega
PLAY_PRODUCT_IDS=banega_weekly_50
PLAY_SERVICE_ACCOUNT_FILE=
PLAY_SERVICE_ACCOUNT_JSON=
# 0 = Android-only: the APPSTORE_* credentials are not required outside dev.
APPSTORE_ENABLED=1
# App Store: signed notifications are verified against Apple Root CA - G3 (bundled).
APPSTORE_BUNDLE_ID=
APPSTORE_ENVIRONMENT=Production
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=

# Staff admin panel. Staff accounts: python -m app.cli staff-create --email you@banega.app
# (prints the TOTP URI). ADMIN_USERNAME / ADMIN_PASSWORD only work in dev while no staff
# account exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET_KEY=dev-only-admin-secret-change-me
# Optional: only these CIDRs reach /admin through nginx, e.g. "203.0.113.0/24,198.51.100.7".
ADMIN_ALLOW_CIDR=

# Proxies whose X-Forwarded-For nginx trusts (prod: Caddy). Empty in dev.
REAL_IP_FROM=

# Host port nginx listens on in dev.
HTTP_PORT=8080
# Image tag (prod override requires it) and registry prefix.
IMAGE_TAG=dev
REGISTRY=banega

# Normalise line endings in the repo; scripts and container files stay LF
# (they run in Linux containers), Windows scripts stay CRLF.
* text=auto

*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.template text eol=lf
*.yml text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.ttf binary
*.pdf binary
*.jks binary
